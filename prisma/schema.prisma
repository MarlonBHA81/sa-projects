// Story Advantage BRS funnel tool — data model.
// The schema encodes the Brand Resonance System: engagements (DIY/DWY/DFY),
// funnel builds, staged deliverables-as-tasks with buildable processes and
// verification checklists, the gate engine, time tracking, financials, and the
// advisory AI layer. See /root/.claude/plans for the full plan.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used by `prisma migrate`/introspection. On Vercel Postgres, point this at
  // the non-pooling connection while DATABASE_URL uses the pooled one.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  STRATEGY
  COPY
  DESIGN
  DEV
  SALES
}

enum Department {
  STRATEGY
  COPY
  DESIGN
  DEV
  SALES
}

enum BrsPhase {
  DIFFERENTIATE
  INTEGRATE
  ACTIVATE
}

enum StageStatus {
  LOCKED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  PAUSED
}

enum DeliverableStatus {
  BLOCKED
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  CHANGES_NEEDED
  APPROVED
  PAUSED
}

enum DeliverableKind {
  STANDARD
  OPTIONS_REQUIRED
  PLAYBOOK
}

enum ChecklistItemKind {
  MANUAL
  GRUNT_TEST
  VOICE
  AI
}

enum ProcessStepStatus {
  TODO
  DONE
}

enum ApprovalDecision {
  APPROVED
  CHANGES_NEEDED
}

enum GruntTestResult {
  PASS
  FAIL
  NOT_TESTED
}

enum ConversionGoal {
  BOOK_A_CALL
  BUY
  REGISTER
}

enum DeliveryType {
  DIY
  DWY
  DFY
}

enum EngagementStatus {
  LEAD
  PROPOSED
  WON
  ACTIVE
  COMPLETED
  LOST
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ActivityType {
  PROJECT_CREATED
  DELIVERABLE_STARTED
  DELIVERABLE_SUBMITTED
  DELIVERABLE_APPROVED
  DELIVERABLE_CHANGES_NEEDED
  OPTION_ADDED
  OPTION_SELECTED
  STAGE_GATE_CLEARED
  COPY_CHANGED_RESYNC
  GRUNT_TEST_RECORDED
  CHECKLIST_ITEM_CHECKED
  COMMENT_ADDED
  PLAYBOOK_UPDATED
  TIMER_STARTED
  TIMER_STOPPED
  TIME_LOGGED
  DELIVERABLE_ASSIGNED
  DUE_DATE_SET
  GHL_SYNCED
  LEAD_IMPORTED
  LEAD_PUSHED
  MILESTONE_PUSHED
  SLACK_NOTIFIED
  AI_INSIGHT_CREATED
  AI_INSIGHT_RESOLVED
  ENGAGEMENT_COMPLETED
  PNL_GENERATED
  CLIENT_CREATED
  CLIENT_UPDATED
  ENGAGEMENT_CREATED
  ENGAGEMENT_UPDATED
  BUILD_CREATED
  DELIVERABLE_UPDATED
  DELIVERABLE_MOVED
  SPRINT_CREATED
  SPRINT_UPDATED
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  ITEM_SOFT_DELETED
  ITEM_RESTORED
  ITEM_PURGED
  PROJECT_UPDATED
  PROJECT_FINISHED
  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_MOVED
  TASK_ASSIGNED
  TASK_COMMENTED
  CHECKLIST_ITEM_ADDED
  CHECKLIST_ITEM_TOGGLED
  TIMESHEET_LOGGED
  TIMESHEET_TIMER_STARTED
  TIMESHEET_TIMER_STOPPED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  PROJECT_FILE_ADDED
  PROJECT_DISCUSSION_CREATED
  PROJECT_DISCUSSION_COMMENTED
  PROJECT_NOTE_ADDED
  TASK_BILLED
  PROJECT_CREATED_FROM_TEMPLATE
}

enum AiScope {
  DELIVERABLE
  STAGE
  BUILD
  PORTFOLIO
}

enum AiInsightType {
  GRUNT_TEST
  VOICE
  SB7_ALIGNMENT
  BOTTLENECK
  SLIPPAGE
  TREND
  PROCESS_SUGGESTION
}

enum AiSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

enum AiInsightStatus {
  NEW
  ACKNOWLEDGED
  APPLIED
  DISMISSED
}

enum PlanningLane {
  BACKLOG
  TODO
  DOING
  BLOCKED
  DONE
}

// Perfex task status set. Integer-coded in Perfex (1 Not Started, 2 Awaiting
// Feedback, 3 Testing, 4 In Progress, 5 Complete); we keep the names and derive
// "complete" from COMPLETE. This is the project task board state, never a BRS gate.
enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  TESTING
  AWAITING_FEEDBACK
  COMPLETE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

// Perfex project status set (1 Not Started, 2 In Progress, 3 On Hold,
// 4 Finished, 5 Cancelled). "Mark finished" stamps dateFinished.
enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  FINISHED
  CANCELLED
}

// Perfex billing types (1 Fixed Rate, 2 Project Hours, 3 Task Hours). The type
// is locked once any task on the project has been billed.
enum ProjectBillingType {
  FIXED_RATE
  PROJECT_HOURS
  TASK_HOURS
}

// Project template kinds. PROCESS is a fixed milestone+task tree instantiated
// whole (the flagship is the BRS process in Perfex terms). SPRINT models each
// sprint as a milestone carrying sprint metadata so the milestone board drives
// execution. UNSTRUCTURED is a near-empty template: just the project + settings.
enum ProjectTemplateKind {
  PROCESS
  SPRINT
  UNSTRUCTURED
}

// ---------------------------------------------------------------------------
// Auth.js v5 models + User
// ---------------------------------------------------------------------------

model User {
  id                  String      @id @default(cuid())
  name                String?
  email               String      @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String
  role                Role
  department          Department?
  weeklyCapacityHours Int?
  costRatePerHour     Decimal?    @db.Decimal(10, 2)
  billRatePerHour     Decimal?    @db.Decimal(10, 2)
  billable            Boolean     @default(true)

  accounts             Account[]
  sessions             Session[]
  assignedDeliverables Deliverable[]
  processSteps         ProcessStep[]
  checkedItems         ChecklistItem[]
  timeEntries          TimeEntry[]
  comments             Comment[]
  approvals            Approval[]
  activities           Activity[]
  resolvedInsights     AiInsight[]
  aiUsage              AiUsageLog[]
  ownedProjects        Project[]
  assignedTasks        Task[]
  projectMemberships   ProjectMember[]
  taskAssignments      TaskAssignee[]
  taskFollows          TaskFollower[]
  taskComments         TaskComment[]
  timesheets           Timesheet[]
  projectActivities    ProjectActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Commercial: clients, engagements, financials
// ---------------------------------------------------------------------------

model Client {
  id               String       @id @default(cuid())
  name             String
  industry         String?
  notes            String?
  ghlLocationId    String?
  // GHL contact/opportunity binding so a Perfex-style project resolves its
  // customer through the GHL-synced client. See lib/ghl/sync.ts.
  ghlContactId     String?
  ghlOpportunityId String?
  engagements      Engagement[]
  projects         Project[]
  deletedAt        DateTime?
  deletedById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([name])
}

model Engagement {
  id                 String           @id @default(cuid())
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId           String
  name               String
  deliveryType       DeliveryType
  status             EngagementStatus @default(ACTIVE)
  listPrice          Decimal?         @db.Decimal(12, 2)
  price              Decimal?         @db.Decimal(12, 2)
  costBudget         Decimal?         @db.Decimal(12, 2)
  costAlertThreshold Int?
  currency           String           @default("ZAR")
  startDate          DateTime?
  endDate            DateTime?
  completedAt        DateTime?
  deletedAt          DateTime?
  deletedById        String?

  funnelBuilds FunnelBuild[]
  payments     Payment[]
  costs        EngagementCost[]
  pnl          PnLStatement?
  activities   Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

model Payment {
  id           String        @id @default(cuid())
  engagement   Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("ZAR")
  status       PaymentStatus @default(PAID)
  paidAt       DateTime?
  ghlRef       String?       @unique
  createdAt    DateTime      @default(now())

  @@index([engagementId])
}

model EngagementCost {
  id           String     @id @default(cuid())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  label        String
  category     String?
  amount       Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())

  @@index([engagementId])
}

model PnLStatement {
  id           String     @id @default(cuid())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String     @unique
  revenueTotal Decimal    @db.Decimal(12, 2)
  deliveryCost Decimal    @db.Decimal(12, 2)
  adSpend      Decimal    @db.Decimal(12, 2)
  otherCosts   Decimal    @db.Decimal(12, 2)
  grossProfit  Decimal    @db.Decimal(12, 2)
  marginPct    Float
  lines        Json
  summary      String?
  generatedAt  DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// The work: funnel builds, stages, deliverables (tasks)
// ---------------------------------------------------------------------------

model FunnelBuild {
  id              String          @id @default(cuid())
  engagement      Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId    String
  name            String
  conversionGoal  ConversionGoal?
  audienceSegment String?
  currentPhase    BrsPhase        @default(DIFFERENTIATE)
  templateKey     String          @default("brs-standard-v1")
  ghlLocationId   String?
  ghlLastSyncedAt DateTime?

  stages        Stage[]
  deliverables  Deliverable[]
  brandPlaybook BrandPlaybook?
  comments      Comment[]
  activities    Activity[]
  channels      RevenueChannel[]
  leads         Lead[]
  sprints       Sprint[]
  tasks         Task[]
  deletedAt     DateTime?
  deletedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([engagementId])
}

model Stage {
  id            String      @id @default(cuid())
  funnelBuild   FunnelBuild @relation(fields: [funnelBuildId], references: [id], onDelete: Cascade)
  funnelBuildId String
  order         Int
  key           String
  title         String
  phase         BrsPhase
  status        StageStatus @default(LOCKED)
  approvedAt    DateTime?

  deliverables Deliverable[]
  snapshots    BurndownSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funnelBuildId, order])
  @@unique([funnelBuildId, key])
  @@index([funnelBuildId, status])
}

model Deliverable {
  id                    String            @id @default(cuid())
  funnelBuild           FunnelBuild       @relation(fields: [funnelBuildId], references: [id], onDelete: Cascade)
  funnelBuildId         String
  stage                 Stage             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageId               String
  key                   String
  title                 String
  description           String?
  department            Department
  kind                  DeliverableKind   @default(STANDARD)
  status                DeliverableStatus @default(BLOCKED)
  order                 Int
  isCopy                Boolean           @default(false)
  requiresGruntTest     Boolean           @default(false)
  requireReviewResolved Boolean           @default(true)
  body                  Json?
  estimateMinutes       Int?
  dueDate               DateTime?
  startedAt             DateTime?
  approvedAt            DateTime?
  assignee              User?             @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId            String?
  planningLane          PlanningLane      @default(BACKLOG)
  sprint                Sprint?           @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  sprintId              String?
  deletedAt             DateTime?
  deletedById           String?

  dependsOn      DeliverableDependency[] @relation("Dependent")
  dependedOnBy   DeliverableDependency[] @relation("Prerequisite")
  processSteps   ProcessStep[]
  checklistItems ChecklistItem[]
  optionSet      OptionSet?
  approvals      Approval[]
  gruntTests     GruntTestCheck[]
  comments       Comment[]
  activities     Activity[]
  timeEntries    TimeEntry[]
  brandPlaybook  BrandPlaybook?
  rounds         DeliverableRound[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([funnelBuildId, key])
  @@index([stageId, status])
  @@index([funnelBuildId, isCopy, status])
  @@index([department, status])
  @@index([assigneeId])
}

model DeliverableRound {
  id            String      @id @default(cuid())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId String
  roundNumber   Int
  body          Json?
  note          String?
  submittedById String?
  createdAt     DateTime    @default(now())

  @@unique([deliverableId, roundNumber])
  @@index([deliverableId, roundNumber])
}

model DeliverableDependency {
  id             String      @id @default(cuid())
  dependent      Deliverable @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)
  dependentId    String
  prerequisite   Deliverable @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  prerequisiteId String

  @@unique([dependentId, prerequisiteId])
  @@index([prerequisiteId])
}

model ProcessStep {
  id              String            @id @default(cuid())
  deliverable     Deliverable       @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId   String
  order           Int
  title           String
  description     String?
  estimateMinutes Int?
  status          ProcessStepStatus @default(TODO)
  assignee        User?             @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliverableId, order])
}

model ChecklistItem {
  id            String            @id @default(cuid())
  deliverable   Deliverable       @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId String
  order         Int
  label         String
  kind          ChecklistItemKind @default(MANUAL)
  required      Boolean           @default(true)
  checked       Boolean           @default(false)
  checkedBy     User?             @relation(fields: [checkedById], references: [id], onDelete: SetNull)
  checkedById   String?
  checkedAt     DateTime?
  note          String?
  gruntTest     GruntTestCheck?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliverableId, order])
}

model GruntTestCheck {
  id              String          @id @default(cuid())
  deliverable     Deliverable     @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId   String
  checklistItem   ChecklistItem?  @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  checklistItemId String?         @unique
  option          Option?         @relation(fields: [optionId], references: [id], onDelete: SetNull)
  optionId        String?
  passWhatOffered Boolean         @default(false)
  passHowItHelps  Boolean         @default(false)
  passWhatToDo    Boolean         @default(false)
  result          GruntTestResult @default(NOT_TESTED)
  testedText      String
  note            String?
  testedById      String?
  createdAt       DateTime        @default(now())

  @@index([deliverableId, createdAt])
}

model OptionSet {
  id               String      @id @default(cuid())
  deliverable      Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId    String      @unique
  prompt           String
  minOptions       Int         @default(2)
  maxOptions       Int         @default(3)
  options          Option[]    @relation("SetOptions")
  selectedOption   Option?     @relation("SelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)
  selectedOptionId String?     @unique
  selectedAt       DateTime?
  selectedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Option {
  id          String           @id @default(cuid())
  optionSet   OptionSet        @relation("SetOptions", fields: [optionSetId], references: [id], onDelete: Cascade)
  optionSetId String
  label       String
  content     Json
  rationale   String?
  selectedFor OptionSet?       @relation("SelectedOption")
  gruntTests  GruntTestCheck[]

  createdAt DateTime @default(now())

  @@index([optionSetId])
}

model Approval {
  id            String           @id @default(cuid())
  deliverable   Deliverable      @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId String
  approver      User             @relation(fields: [approverId], references: [id])
  approverId    String
  decision      ApprovalDecision
  note          String?
  createdAt     DateTime         @default(now())

  @@index([deliverableId, createdAt])
}

model BrandPlaybook {
  id            String      @id @default(cuid())
  funnelBuild   FunnelBuild @relation(fields: [funnelBuildId], references: [id], onDelete: Cascade)
  funnelBuildId String      @unique
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId String      @unique
  brandMessage  String?
  oneLiner      String?
  tagline       String?
  bios          Json?
  salesPitch    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id              String       @id @default(cuid())
  body            String
  isHandoff       Boolean      @default(false)
  isChangeRequest Boolean      @default(false)
  resolved        Boolean      @default(false)
  resolvedById    String?
  resolvedAt      DateTime?
  author          User         @relation(fields: [authorId], references: [id])
  authorId        String
  deliverable     Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId   String?
  funnelBuild     FunnelBuild? @relation(fields: [funnelBuildId], references: [id], onDelete: Cascade)
  funnelBuildId   String?
  fromDept        Department?
  toDept          Department?
  createdAt       DateTime     @default(now())

  @@index([deliverableId, createdAt])
  @@index([funnelBuildId, createdAt])
}

model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  engagement    Engagement?  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId  String?
  funnelBuild   FunnelBuild? @relation(fields: [funnelBuildId], references: [id], onDelete: Cascade)
  funnelBuildId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  deliverableId String?
  actor         User         @relation(fields: [actorId], references: [id])
  actorId       String
  summary       String
  meta          Json?
  entityType    String?
  entityId      String?
  createdAt     DateTime     @default(now())

  @@index([funnelBuildId, createdAt])
  @@index([engagementId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Time tracking, capacity, burn-down
// ---------------------------------------------------------------------------

model TimeEntry {
  id              String       @id @default(cuid())
  deliverable     Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId   String?
  task            Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  startedAt       DateTime     @default(now())
  endedAt         DateTime?
  durationMinutes Int?
  note            String?
  isRunning       Boolean      @default(true)
  createdAt       DateTime     @default(now())

  @@index([deliverableId])
  @@index([taskId])
  @@index([userId, isRunning])
}

model BurndownSnapshot {
  id                       String   @id @default(cuid())
  stage                    Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageId                  String
  date                     DateTime @default(now())
  remainingEstimateMinutes Int      @default(0)
  openCount                Int      @default(0)
  approvedCount            Int      @default(0)

  @@index([stageId, date])
}

// ---------------------------------------------------------------------------
// Optimise / close the loop: revenue, leads, GHL
// ---------------------------------------------------------------------------

model RevenueChannel {
  id            String      @id @default(cuid())
  funnelBuild   FunnelBuild @relation(fields: [funnelBuildId], references: [id], onDelete: Cascade)
  funnelBuildId String
  name          String
  leadsCount    Int         @default(0)
  spend         Decimal     @default(0) @db.Decimal(12, 2)
  revenue       Decimal     @default(0) @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([funnelBuildId])
}

model Lead {
  id            String      @id @default(cuid())
  funnelBuild   FunnelBuild @relation(fields: [funnelBuildId], references: [id], onDelete: Cascade)
  funnelBuildId String
  ghlContactId  String
  name          String?
  email         String?
  phone         String?
  source        String?
  status        String?
  value         Decimal?    @db.Decimal(12, 2)
  ghlCreatedAt  DateTime?
  syncedAt      DateTime    @default(now())

  @@unique([funnelBuildId, ghlContactId])
  @@index([funnelBuildId])
}

model GhlConnection {
  id            String    @id @default(cuid())
  funnelBuildId String    @unique
  locationId    String
  tokenRef      String?
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Reusable processes (bottled winning formulas)
// ---------------------------------------------------------------------------

model ProcessTemplate {
  id          String      @id @default(cuid())
  name        String
  description String?
  department  Department?
  steps       Json
  checklist   Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([name])
}

// ---------------------------------------------------------------------------
// Advisory AI layer
// ---------------------------------------------------------------------------

model AiInsight {
  id              String          @id @default(cuid())
  scope           AiScope
  scopeId         String
  type            AiInsightType
  severity        AiSeverity      @default(INFO)
  title           String
  summary         String
  detail          Json?
  suggestions     Json?
  status          AiInsightStatus @default(NEW)
  modelUsed       String?
  inputTokens     Int?
  outputTokens    Int?
  cacheReadTokens Int?
  costUsd         Decimal?        @db.Decimal(10, 4)
  resolvedBy      User?           @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([scope, scopeId])
  @@index([status, severity])
}

model AiUsageLog {
  id               String   @id @default(cuid())
  operation        String
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(10, 4)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId           String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Planning: sprints, the general tracker, and ad-hoc tasks
// ---------------------------------------------------------------------------

model Sprint {
  id            String        @id @default(cuid())
  funnelBuild   FunnelBuild   @relation(fields: [funnelBuildId], references: [id], onDelete: Cascade)
  funnelBuildId String
  name          String
  goal          String?
  startDate     DateTime?
  endDate       DateTime?
  status        SprintStatus  @default(PLANNED)
  deliverables  Deliverable[]
  tasks         Task[]
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([funnelBuildId])
}

// ---------------------------------------------------------------------------
// Perfex-style Project Management. This is the primary "projects" experience.
// It is a separate layer from the BRS gates: a Task's `status` here is the
// Perfex task board state, never a gate. A Project binds to one Client.
// ---------------------------------------------------------------------------

model Project {
  id                String             @id @default(cuid())
  name              String
  description       String?
  status            ProjectStatus      @default(NOT_STARTED)
  billingType       ProjectBillingType @default(FIXED_RATE)
  // The CRM customer link (Perfex `clientid`); synced from GHL.
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId          String?
  // Creator/owner. Kept from the previous lightweight model.
  owner             User               @relation(fields: [ownerId], references: [id])
  ownerId           String
  // If true, `progress` is derived from task completion; if false it is manual.
  progressFromTasks Boolean            @default(true)
  progress          Int                @default(0)
  // Fixed Rate uses projectCost; Project Hours uses ratePerHour; estimatedHours
  // is informational.
  projectCost       Decimal?           @db.Decimal(15, 2)
  ratePerHour       Decimal?           @db.Decimal(15, 2)
  estimatedHours    Decimal?           @db.Decimal(15, 2)
  startDate         DateTime?
  deadline          DateTime?
  dateFinished      DateTime?
  currency          String             @default("ZAR")

  settings    ProjectSettings?
  members     ProjectMember[]
  milestones  Milestone[]
  tasks       Task[]
  files       ProjectFile[]
  discussions ProjectDiscussion[]
  notes       ProjectNote[]
  activities  ProjectActivity[]

  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([clientId])
  @@index([status])
}

// Typed 1:1 customer-portal visibility toggles (the Perfex tblproject_settings
// key set), NOT an EAV table. Admin-only to edit.
model ProjectSettings {
  id                      String  @id @default(cuid())
  project                 Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId               String  @unique
  viewTasks               Boolean @default(false)
  createTasks             Boolean @default(false)
  editTasks               Boolean @default(false)
  commentOnTasks          Boolean @default(false)
  viewTaskComments        Boolean @default(false)
  viewTaskAttachments     Boolean @default(false)
  viewTaskChecklistItems  Boolean @default(false)
  uploadOnTasks           Boolean @default(false)
  viewTaskTotalLoggedTime Boolean @default(false)
  viewFinanceOverview     Boolean @default(false)
  uploadFiles             Boolean @default(false)
  openDiscussions         Boolean @default(false)
  viewMilestones          Boolean @default(false)
  viewGantt               Boolean @default(false)
  viewTimesheets          Boolean @default(false)
  viewActivityLog         Boolean @default(false)
  viewTeamMembers         Boolean @default(false)
  hideTasksOnMainTable    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id                           String    @id @default(cuid())
  project                      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId                    String
  name                         String
  description                  String?
  descriptionVisibleToCustomer Boolean   @default(false)
  color                        String?
  startDate                    DateTime?
  dueDate                      DateTime?
  order                        Int       @default(0)
  hideFromCustomer             Boolean   @default(false)
  tasks                        Task[]
  deletedAt                    DateTime?
  deletedById                  String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([projectId, order])
}

model Task {
  id              String        @id @default(cuid())
  title           String
  description     String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String?
  funnelBuild     FunnelBuild?  @relation(fields: [funnelBuildId], references: [id], onDelete: Cascade)
  funnelBuildId   String?
  milestone       Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  milestoneId     String?
  department      Department?
  sprint          Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  sprintId        String?
  status          TaskStatus    @default(NOT_STARTED)
  priority        TaskPriority?
  planningLane    PlanningLane  @default(TODO)
  // Legacy single assignee (used by the planning board, sprints, workload).
  // Perfex multi-assignee lives in TaskAssignee.
  assignee        User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId      String?
  estimateMinutes Int?
  startDate       DateTime?
  dueDate         DateTime?
  dateFinished    DateTime?
  hourlyRate      Decimal       @default(0) @db.Decimal(15, 2)
  billable        Boolean       @default(false)
  billed          Boolean       @default(false)
  visibleToClient Boolean       @default(false)
  order           Int           @default(0)
  kanbanOrder     Int           @default(0)
  milestoneOrder  Int           @default(0)

  assignees      TaskAssignee[]
  followers      TaskFollower[]
  checklistItems TaskChecklistItem[]
  taskComments   TaskComment[]
  timesheets     Timesheet[]
  timeEntries    TimeEntry[]
  dependsOn      TaskDependency[]    @relation("TaskDependent")
  dependedOnBy   TaskDependency[]    @relation("TaskPrerequisite")

  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
  @@index([projectId, milestoneId])
  @@index([funnelBuildId])
  @@index([sprintId])
  @@index([assigneeId])
}

model TaskAssignee {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

// Followers track a task without being assignees; may be staff who are not
// project members.
model TaskFollower {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskChecklistItem {
  id           String    @id @default(cuid())
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       String
  description  String
  finished     Boolean   @default(false)
  finishedAt   DateTime?
  finishedById String?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([taskId, order])
}

model TaskComment {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

// The core time record: a start/stop timer per task per staff member, with a
// rate snapshot. Billable vs non-billable is a property of the task.
model Timesheet {
  id         String    @id @default(cuid())
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  staff      User      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId    String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  hourlyRate Decimal   @default(0) @db.Decimal(15, 2)
  note       String?
  createdAt  DateTime  @default(now())

  @@index([taskId])
  @@index([staffId])
}

model ProjectFile {
  id                String   @id @default(cuid())
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  fileName          String
  originalFileName  String?
  subject           String?
  description       String?
  fileType          String?
  url               String?
  external          String?
  externalLink      String?
  visibleToCustomer Boolean  @default(false)
  uploadedById      String
  createdAt         DateTime @default(now())

  @@index([projectId])
}

model ProjectDiscussion {
  id             String              @id @default(cuid())
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  subject        String
  description    String?
  showToCustomer Boolean             @default(false)
  authorId       String
  comments       DiscussionComment[]
  lastActivityAt DateTime?
  createdAt      DateTime            @default(now())

  @@index([projectId, createdAt])
}

model DiscussionComment {
  id           String            @id @default(cuid())
  discussion   ProjectDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId String
  authorId     String
  content      String
  createdAt    DateTime          @default(now())

  @@index([discussionId, createdAt])
}

model ProjectNote {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  content   String
  authorId  String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// The per-project audit log shown on the Activity tab. Each entry can be
// toggled visible/hidden to the customer.
model ProjectActivity {
  id                String   @id @default(cuid())
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  actor             User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId           String?
  visibleToCustomer Boolean  @default(false)
  summary           String
  meta              Json?
  createdAt         DateTime @default(now())

  @@index([projectId, createdAt])
}

model TaskDependency {
  id             String @id @default(cuid())
  dependent      Task   @relation("TaskDependent", fields: [dependentId], references: [id], onDelete: Cascade)
  dependentId    String
  prerequisite   Task   @relation("TaskPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  prerequisiteId String

  @@unique([dependentId, prerequisiteId])
  @@index([prerequisiteId])
}

// ---------------------------------------------------------------------------
// Project templates. A detached milestone -> task -> checklist tree with
// defaults only (never live BRS gate status), instantiated by
// createProjectFromTemplate. Templates have no absolute dates: they carry
// offsets resolved against the project start date at creation time.
// ---------------------------------------------------------------------------

model ProjectTemplate {
  id                 String              @id @default(cuid())
  name               String
  kind               ProjectTemplateKind @default(UNSTRUCTURED)
  description        String?
  // Default billing type applied to the created project (defaults FIXED_RATE).
  defaultBillingType ProjectBillingType?
  isActive           Boolean             @default(true)
  order              Int                 @default(0)

  milestones TemplateMilestone[]
  tasks      TemplateTask[]

  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kind, order])
}

model TemplateMilestone {
  id          String          @id @default(cuid())
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String
  name        String
  description String?
  color       String?
  order       Int             @default(0)
  // Resolved against the project start date when instantiated.
  dueOffsetDays Int?
  // SPRINT metadata: a milestone-as-sprint carries its window length and index
  // so the milestone board drives sprint execution.
  durationDays Int?
  sprintIndex  Int?

  tasks TemplateTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId, order])
}

model TemplateTask {
  id                  String             @id @default(cuid())
  template            ProjectTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId          String
  templateMilestone   TemplateMilestone? @relation(fields: [templateMilestoneId], references: [id], onDelete: SetNull)
  templateMilestoneId String?
  title               String
  description         String?
  priority            TaskPriority?
  billable            Boolean            @default(false)
  hourlyRate          Decimal?           @db.Decimal(15, 2)
  estimateMinutes     Int?
  // Both resolved against the project start date when instantiated.
  startOffsetDays     Int?
  dueOffsetDays       Int?
  // The department this task defaults to; resolved to a real user (its
  // department's member) at creation time. Plain Perfex defaults, never a gate.
  defaultAssigneeRole Department?
  order               Int                @default(0)

  checklistItems TemplateChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId, order])
  @@index([templateMilestoneId, order])
}

model TemplateChecklistItem {
  id             String       @id @default(cuid())
  templateTask   TemplateTask @relation(fields: [templateTaskId], references: [id], onDelete: Cascade)
  templateTaskId String
  description    String
  order          Int          @default(0)

  createdAt DateTime @default(now())

  @@index([templateTaskId, order])
}
