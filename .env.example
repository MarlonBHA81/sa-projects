# Database. Local dev uses the docker-compose Postgres below.
# In production point this at a hosted Postgres (Neon or Supabase).
DATABASE_URL="postgresql://sa:sa_local_dev@localhost:5432/sa_projects?schema=public"
# Direct (non-pooling) connection for migrations. Locally it equals DATABASE_URL.
# On Vercel Postgres, set this to the non-pooling URL.
DIRECT_DATABASE_URL="postgresql://sa:sa_local_dev@localhost:5432/sa_projects?schema=public"

# Auth.js v5. Generate one with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="change-me"

# Protects the scheduled cron route handlers. Any long random string.
CRON_SECRET="change-me"

# n8n outbound event webhook. The app POSTs domain events here; n8n posts to Slack.
N8N_EVENT_WEBHOOK_URL=""

# GoHighLevel API v2 (two-way: import leads and payments, push leads and milestones).
GHL_API_BASE="https://services.leadconnectorhq.com"
GHL_API_TOKEN=""
GHL_API_VERSION="2021-07-28"

# Claude API for the advisory AI monitoring layer.
ANTHROPIC_API_KEY=""
AI_MODEL_DEEP="claude-opus-4-8"
AI_MODEL_FAST="claude-haiku-4-5"
